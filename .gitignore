# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/

# Go test artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace
go.work
go.work.sum

# Local environment / secrets
.env

# Runtime data — produced by the server at runtime, not source-controlled.
/data/
/certs/

# User-supplied media — never check in.
/media/
/sample-media/

# Debug/diagnostic dumps captured during development.
log*.txt
nav-trace*
res*.txt
result.txt
problem.txt

# macOS junk
.DS_Store
._*

# Editor/IDE — keep .idea so JetBrains projects work locally, ignore VS Code.
.vscode/

# Claude Code session metadata
.claude/
