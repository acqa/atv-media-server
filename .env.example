# ATV3 Media Server — environment variables
# Copy to .env and fill in.

# Host path to the media library root. Must contain subfolders:
#   movies/  — movies
#   series/  — TV shows
MEDIA_PATH=./sample-media

# TMDb API key (https://www.themoviedb.org/settings/api).
# Empty value — metadata enrichment is disabled,
# movies will appear only with the file name and a placeholder poster.
TMDB_API_KEY=

# Static IP of the server machine on the local network.
# Used by CoreDNS to answer for appletv.redbull.tv.
# Find it via: `ip route get 1.1.1.1` or in your router settings.
MEDIA_SERVER_IP=192.168.1.100

# Host we impersonate. No need to change.
BASE_HOST=appletv.redbull.tv

# HTTP/HTTPS ports inside the container (mapped 1:1 outside).
HTTP_PORT=80
HTTPS_PORT=443

# Web admin. Empty values disable the admin.
ADMIN_USER=
ADMIN_PASS=

# Transcode cache limit in gigabytes.
TRANSCODE_CACHE_MAX_GB=50

# Optional. DNS-over-HTTPS endpoints used to resolve TMDb hosts
# (api.themoviedb.org, image.tmdb.org) on networks where the system resolver
# returns 127.0.0.1 / ::1 for them. Comma-separated list; tried in order until
# one yields a non-loopback answer. Leave unset to use the built-in defaults:
# Cloudflare primary + Quad9 fallback. Note: Google DoH is intentionally
# excluded — its RU-edge recursors honour the local blocklist.
# DOH_URL=https://cloudflare-dns.com/dns-query,https://dns.quad9.net/dns-query
