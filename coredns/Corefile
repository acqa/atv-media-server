# CoreDNS config for ATV3 hijacking.
#
# Resolves `appletv.redbull.tv` to the media server's IP and forwards
# everything else upstream so ATV3 still browses the internet.
#
# __MEDIA_SERVER_IP__ is substituted at container start by docker-compose's
# entrypoint shim (see docker-compose.yml: dns.command).
.:53 {
    template IN A appletv.redbull.tv {
        match "^appletv\.redbull\.tv\.$"
        answer "{{ .Name }} 60 IN A __MEDIA_SERVER_IP__"
        fallthrough
    }
    forward . 1.1.1.1 8.8.8.8 {
        max_concurrent 1000
    }
    cache 30
    log
    errors
}
