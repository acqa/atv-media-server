{{ define "body" -}}
<itemDetail id="{{ .BodyID }}">
  <title>{{ .Data.Title }}{{ if .Data.Year }} ({{ .Data.Year }}){{ end }}</title>
  <summary>{{ if .Data.Description }}{{ .Data.Description }}{{ else }}Description not found.{{ end }}</summary>

  {{- if .Data.HasPoster }}
  <image style="moviePoster">{{ .BasePath }}/art-series/{{ .Data.ID }}.jpg?type=poster&amp;size=w780</image>
  {{- else }}
  <image style="moviePoster">resource://Poster.png</image>
  {{- end }}
  <defaultImage>resource://Poster.png</defaultImage>

  {{- if .Data.HasRating }}
  <table>
    <columnDefinitions>
      <columnDefinition width="50" alignment="left">
        <title>Rating</title>
      </columnDefinition>
    </columnDefinitions>
    <rows>
      <row>
        <starRating>
          <percentage>{{ .Data.RatingPercent }}</percentage>
        </starRating>
      </row>
    </rows>
  </table>
  {{- end }}

  <centerShelf>
    <shelf id="seasons" columnCount="{{ .Data.SeasonColumns }}">
      <sections>
        <shelfSection>
          <items>
            {{- range .Data.Seasons }}
            <actionButton
                id="season-{{ $.Data.ID }}-{{ . }}"
                onSelect="atvutils.loadURL('{{ $.BasePath }}/season.xml?show={{ $.Data.ID }}&amp;s={{ . }}');"
                onPlay="atvutils.loadURL('{{ $.BasePath }}/season.xml?show={{ $.Data.ID }}&amp;s={{ . }}');">
              <title>Season {{ . }}</title>
              <image>resource://Folder.png</image>
              <focusedImage>resource://Folder.png</focusedImage>
            </actionButton>
            {{- end }}
          </items>
        </shelfSection>
      </sections>
    </shelf>
  </centerShelf>
</itemDetail>
{{- end }}
