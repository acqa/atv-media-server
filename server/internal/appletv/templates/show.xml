{{ define "body" -}}
<itemDetailWithImageHeader id="{{ .BodyID }}" layout="compact">
  {{- if .Data.HasBackdrop }}
  <header>
    <imageHeader>
      <image insets="0, 0, 440, 0" required="true">{{ .BasePath }}/series-poster/{{ .Data.ID }}.jpg?type=backdrop&amp;size=w1280</image>
    </imageHeader>
  </header>
  {{- end }}

  <title>{{ .Data.Title }}{{ if .Data.Year }} ({{ .Data.Year }}){{ end }}</title>
  <summary>{{ if .Data.Description }}{{ .Data.Description }}{{ else }}Description not found.{{ end }}</summary>

  {{- if .Data.HasPoster }}
  <image style="moviePoster">{{ .BasePath }}/series-poster/{{ .Data.ID }}.jpg?type=poster&amp;size=w780</image>
  {{- end }}
  <defaultImage>resource://Poster.png</defaultImage>

  {{- if .Data.HasRating }}
  <userRatings>
    <starRating>
      <percentage>{{ .Data.RatingPercent }}</percentage>
    </starRating>
  </userRatings>
  {{- end }}

  <centerShelf>
    <shelf id="seasons" columnCount="{{ .Data.SeasonColumns }}" center="true">
      <sections>
        <shelfSection>
          <items>
            {{- range .Data.Seasons }}
            <actionButton
                id="season-{{ $.Data.ID }}-{{ . }}"
                onSelect="atvutils.loadURL('{{ $.BasePath }}/season.xml?show={{ $.Data.ID }}&amp;s={{ . }}');"
                onPlay="atvutils.loadURL('{{ $.BasePath }}/season.xml?show={{ $.Data.ID }}&amp;s={{ . }}');">
              <title>Season {{ . }}</title>
              <image>resource://Folder.png</image>
              <focusedImage>resource://Folder.png</focusedImage>
            </actionButton>
            {{- end }}
          </items>
        </shelfSection>
      </sections>
    </shelf>
  </centerShelf>
</itemDetailWithImageHeader>
{{- end }}
