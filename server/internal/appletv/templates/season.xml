{{ define "body" -}}
<listScrollerSplit id="{{ .BodyID }}">
  <header>
    <simpleHeader accessibilityLabel="Season {{ .Data.Season }}">
      <title>Season {{ .Data.Season }}</title>
    </simpleHeader>
  </header>
  <menu>
    <sections>
      <menuSection>
        <header>
          <textDivider alignment="left" accessibilityLabel="Episodes">
            <title>Episodes</title>
          </textDivider>
        </header>
        <items>
          {{- range .Data.Episodes }}
          <oneLineMenuItem
              id="episode-{{ .ID }}"
              accessibilityLabel="S{{ printf "%02d" .Season }}E{{ printf "%02d" .Episode }}"
              onSelect="atvutils.loadURL('{{ $.BasePath }}/episode.xml?id={{ .ID }}');"
              onPlay="atvutils.loadAndSwapURL('{{ $.BasePath }}/play.xml?id={{ .ID }}');">
            <label>S{{ printf "%02d" .Season }}E{{ printf "%02d" .Episode }}{{ if .Title }} — {{ .Title }}{{ end }}</label>
          </oneLineMenuItem>
          {{- end }}
        </items>
      </menuSection>
    </sections>
  </menu>
</listScrollerSplit>
{{- end }}
