{{ define "body" -}}
<scroller id="{{ .BodyID }}">
  <header>
    <simpleHeader accessibilityLabel="Season {{ .Data.Season }}">
      <title>Season {{ .Data.Season }}</title>
    </simpleHeader>
  </header>
  <items>
    <grid columnCount="3" id="episodes-grid">
      <items>
        {{- range .Data.Episodes }}
        <sixteenByNinePoster
            id="episode-{{ .ID }}"
            alwaysShowTitles="true"
            onSelect="atvutils.loadURL('{{ $.BasePath }}/episode.xml?id={{ .ID }}');"
            onPlay="atvutils.loadAndSwapURL('{{ $.BasePath }}/play.xml?id={{ .ID }}');">
          <title>{{ .Episode }}.{{ if .Title }} {{ .Title }}{{ else }} Episode {{ .Episode }}{{ end }}</title>
          {{- if .DurationStr }}
          <subtitle>{{ .DurationStr }}</subtitle>
          {{- end }}
          {{- if .HasStill }}
          <image>{{ $.BasePath }}/episode-still/{{ .ID }}.jpg?size=w780</image>
          {{- end }}
          <defaultImage>resource://16x9.png</defaultImage>
        </sixteenByNinePoster>
        {{- end }}
      </items>
    </grid>
  </items>
</scroller>
{{- end }}
