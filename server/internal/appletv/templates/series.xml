{{ define "body" -}}
<scroller id="{{ .BodyID }}">
  <header>
    <simpleHeader accessibilityLabel="TV Shows">
      <title>TV Shows</title>
    </simpleHeader>
  </header>
  <items>
    <grid columnCount="7" id="series-grid">
      <items>
        {{- range .Data.Series }}
        <moviePoster
            id="series-{{ .ID }}"
            alwaysShowTitles="true"
            onSelect="atvutils.loadURL('{{ $.BasePath }}/show.xml?id={{ .ID }}');">
          <title>{{ .Title }}</title>
          {{- if .Year }}
          <subtitle>{{ .Year }}</subtitle>
          {{- end }}
          {{- if .HasPoster }}
          <image>{{ $.BasePath }}/art-series/{{ .ID }}.jpg?type=poster&amp;size=w500</image>
          {{- end }}
          <defaultImage>resource://Poster.png</defaultImage>
        </moviePoster>
        {{- end }}
      </items>
    </grid>
  </items>
</scroller>
{{- end }}
