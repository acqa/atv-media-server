{{ define "body" -}}
<scroller id="{{ .BodyID }}">
  <header>
    <simpleHeader accessibilityLabel="Movies">
      <title>Movies</title>
    </simpleHeader>
  </header>
  <items>
    <grid columnCount="7" id="movies-grid">
      <items>
        {{- range .Data.Movies }}
        <moviePoster
            id="movie-{{ .ID }}"
            alwaysShowTitles="true"
            onSelect="atvutils.loadURL('{{ $.BasePath }}/movie.xml?id={{ .ID }}');"
            onPlay="atvutils.loadAndSwapURL('{{ $.BasePath }}/play.xml?id={{ .ID }}');">
          <title>{{ .Title }}</title>
          {{- if .Year }}
          <subtitle>{{ .Year }}</subtitle>
          {{- end }}
          {{- if .HasPoster }}
          <image>{{ $.BasePath }}/poster/{{ .ID }}.jpg?type=poster&amp;size=w500</image>
          {{- end }}
          <defaultImage>resource://Poster.png</defaultImage>
        </moviePoster>
        {{- end }}
      </items>
    </grid>
  </items>
</scroller>
{{- end }}
